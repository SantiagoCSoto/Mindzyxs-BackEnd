# Plantilla de variables locales (desarrollo). Copiar a .env (ignorado por git).
# NUNCA commitear valores reales.

# Firebase (chat): ruta al JSON de cuenta de servicio (relativa a la carpeta del .env).
GOOGLE_APPLICATION_CREDENTIALS=Repositories/RealTime/mindzyxs-firebase-adminsdk-<proyecto>.json

# Secretos y configuraciones sensibles: usar .NET User Secrets (recomendado) o variables de entorno.
# En Azure App Service se configuran en Configuration -> Application settings con estos nombres:
# ConnectionStrings__Mindzyxs=Server=tcp:<server>.database.windows.net,1433;Database=Mindzyxs;User Id=...;Password=...;Encrypt=True;TrustServerCertificate=False;
# Admin__BackupConnectionString=Server=tcp:<server>.database.windows.net,1433;Database=Mindzyxs;User Id=...;Password=...;Encrypt=True;TrustServerCertificate=False;
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
# Smtp__User=<correo>
# Smtp__Pass=<app-password>
# Smtp__From=<correo>
# Smtp__EnableSsl=true
# Firebase__ProjectId=mindzyxs
# Firebase__DatabaseUrl=https://<proyecto>-default-rtdb.<region>.firebasedatabase.app
# Storage__TarjetasPath=C:\uploads\mindzyxs\tarjetas   (solo dev; en Azure usar Blob Storage)
# Admin__BackupsPath=C:\uploads\mindzyxs\backups       (solo dev; en Azure usar Blob Storage)
# ASPNETCORE_ENVIRONMENT=Development