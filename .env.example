# Plantilla de variables locales (desarrollo). Copiar a .env (ignorado por git).
# NUNCA commitear valores reales.
GOOGLE_APPLICATION_CREDENTIALS=Repositories/RealTime/mindzyxs-firebase-adminsdk-<proyecto>.json
# Los secretos de BD/SMTP van en appsettings.Development.json (no commitear) o user-secrets:
# ConnectionStrings__Mindzyxs=Server=...;Database=Mindzyxs;User Id=...;Password=...;Encrypt=True
# Smtp__Pass=<app-password>
