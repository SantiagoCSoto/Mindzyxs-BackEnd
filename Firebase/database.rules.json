{
  "rules": {
    "conversaciones": {
      "$convId": {
        "meta": {
          ".read": "auth != null",
          ".write": false
        },
        "mensajes": {
          ".read": "auth != null && (root.child('conversaciones/' + $convId + '/meta/pacienteUid').val() == auth.uid || root.child('conversaciones/' + $convId + '/meta/psicologoUid').val() == auth.uid)",
          "$msgId": {
            ".write": "auth != null && (!data.exists()) && newData.child('remitenteUid').val() == auth.uid && (root.child('conversaciones/' + $convId + '/meta/pacienteUid').val() == auth.uid || root.child('conversaciones/' + $convId + '/meta/psicologoUid').val() == auth.uid) && root.child('conversaciones/' + $convId + '/meta/estado').val() == 'Aceptada' && (!root.child('conversaciones/' + $convId + '/meta/bloqueadoPor').exists() || root.child('conversaciones/' + $convId + '/meta/bloqueadoPor').val() == auth.uid)",
            ".validate": "newData.hasChildren(['remitenteUid', 'texto', 'fecha']) && newData.child('texto').isString() && newData.child('texto').val().length > 0 && newData.child('texto').val().length <= 1000"
          }
        },
        "presencia": {
          "$uid": {
            ".read": "auth != null && (root.child('conversaciones/' + $convId + '/meta/pacienteUid').val() == auth.uid || root.child('conversaciones/' + $convId + '/meta/psicologoUid').val() == auth.uid)",
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "typing": {
          "$uid": {
            ".read": "auth != null && (root.child('conversaciones/' + $convId + '/meta/pacienteUid').val() == auth.uid || root.child('conversaciones/' + $convId + '/meta/psicologoUid').val() == auth.uid)",
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "visto": {
          ".read": "auth != null && (root.child('conversaciones/' + $convId + '/meta/pacienteUid').val() == auth.uid || root.child('conversaciones/' + $convId + '/meta/psicologoUid').val() == auth.uid)",
          "$msgId": {
            "$uid": {
              ".read": "auth != null && (root.child('conversaciones/' + $convId + '/meta/pacienteUid').val() == auth.uid || root.child('conversaciones/' + $convId + '/meta/psicologoUid').val() == auth.uid)",
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
