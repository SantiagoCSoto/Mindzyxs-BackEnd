@Host = http://localhost:5015

### PB-01 catálogos (HU1 tipos + HU2 géneros)
GET {{Host}}/api/account/catalogos
Accept: application/json

### PB-01 registro paciente (HU1+HU2). multipart (HU3 sin tarjeta)
POST {{Host}}/api/account/register
Content-Type: multipart/form-data; boundary=pb01

--pb01
Content-Disposition: form-data; name="TipoUsuario"

Paciente
--pb01
Content-Disposition: form-data; name="Nombre"

Camila
--pb01
Content-Disposition: form-data; name="Apellido"

Rojas
--pb01
Content-Disposition: form-data; name="FechaNacimiento"

2004-05-10
--pb01
Content-Disposition: form-data; name="IdGenero"

2
--pb01
Content-Disposition: form-data; name="Correo"

paciente.nuevo@test.com
--pb01
Content-Disposition: form-data; name="Password"

Abc12345
--pb01--

### PB-01 verificar (HU4)
POST {{Host}}/api/account/verify
Content-Type: application/json

{
  "correo": "paciente.nuevo@test.com",
  "codigo": "123456"
}

### PB-01 reenviar código (HU4)
POST {{Host}}/api/account/resend
Content-Type: application/json

{
  "correo": "paciente.nuevo@test.com"
}

### PB-06 acceder en modo invitado (HU1-PB6)
POST {{Host}}/api/invitado/acceso
Content-Type: application/json

{
  "origen": "landing",
  "resultado": "ok"
}

### PB-06 acceder modo invitado - error (HU1-PB6)
POST {{Host}}/api/invitado/acceso
Content-Type: application/json

{
  "origen": "landing",
  "resultado": "error"
}

### PB-06 panel de invitado (HU1-PB6)
GET {{Host}}/api/invitado/panel
Accept: application/json

### PB-06 intento bloqueado funcion exclusiva (HU1-PB6)
POST {{Host}}/api/invitado/bloqueo
Content-Type: application/json

{
  "funcion": "Historial emocional"
}

### PB-06 salida del modo invitado (HU1-PB6)
POST {{Host}}/api/invitado/salida
Content-Type: application/json

{
  "origen": "panel"
}

### PB-04 contenido del mensaje aclaratorio (HU1-PB4)
GET {{Host}}/api/aviso
Accept: application/json

### PB-04 registrar visualizacion (HU1-PB4, log en dbo.auth)
POST {{Host}}/api/aviso/visualizacion
Content-Type: application/json

{
  "origen": "enlace",
  "resultado": "ok"
}

### PB-04 registrar error de carga del mensaje (HU1-PB4)
POST {{Host}}/api/aviso/visualizacion
Content-Type: application/json

{
  "origen": "auto:cuestionario",
  "resultado": "error"
}
