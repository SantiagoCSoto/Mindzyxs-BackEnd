Authorization: Bearer <token-psicologo>
Content-Type: application/json
Accept: application/json

{
  "titulo": "Ansiedad semanal (revisado)",
  "descripcion": "Seguimiento de síntomas - versión editada",
  "publicar": false,
  "umbrales": { "bajoMax": 6, "medioMax": 12 },
  "preguntas": [
    {
      "id": 10,
      "texto": "¿Con qué frecuencia se sintió nervioso/a esta semana?",
      "tipo": "opcion_multiple",
      "opciones": [
        { "texto": "Nunca", "valor": 0 },
        { "texto": "A veces", "valor": 2 },
        { "texto": "Siempre", "valor": 4 }
      ]
    },
    {
      "texto": "¿Le costó conciliar el sueño?",
      "tipo": "opcion_multiple",
      "opciones": [
        { "texto": "No", "valor": 0 },
        { "texto": "A veces", "valor": 2 },
        { "texto": "Casi siempre", "valor": 4 }
      ]
    }
  ]
}

